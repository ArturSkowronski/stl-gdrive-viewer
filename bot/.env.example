# Telegram Bot — from @BotFather (create a new bot, copy the HTTP API token).
TELEGRAM_BOT_TOKEN=

# Telegram client credentials — from https://my.telegram.org →
# "API development tools". Needed by the self-hosted Telegram Bot API
# server (the bot itself talks to the bot token; the SERVER uses these
# to relay traffic to the Telegram cloud).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated list of Telegram user IDs allowed to send forwards
# to the bot. Forward a message to https://t.me/userinfobot to get
# your own. Leave empty to accept anyone who finds the bot — NOT
# recommended, since uploads land in YOUR Drive.
ALLOWED_USER_IDS=

# Drive folder where the bot will create per-model subfolders. Same
# value as `GDRIVE_ROOT_FOLDER_ID` used by the scanner — new uploads
# get indexed by the next refresh.yml run.
DRIVE_ROOT_FOLDER_ID=

# Google OAuth refresh token with the FULL `drive` scope (write access).
# Mint by running, on a machine with a browser:
#
#     python scanner/auth_bootstrap.py path/to/client_secret.json --write
#
# Then paste the three printed values below. The scanner side keeps
# using its own readonly token; nothing about the daily refresh changes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
